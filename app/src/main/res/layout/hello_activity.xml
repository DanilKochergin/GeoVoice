<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/linear_bg"
    android:padding="32dp"
    tools:context=".HelloActivity">

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:alpha="0.3"
        android:background="@drawable/bg_glow_gradient"
        tools:layout_editor_absoluteX="56dp"
        tools:layout_editor_absoluteY="190dp"
        app:layout_constraintBottom_toTopOf="@id/btnRu"
        android:layout_marginBottom="250dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerGroup"
        />

    <LinearLayout
        android:id="@+id/headerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.03"
            android:lineSpacingMultiplier="1.0"
            android:text="@string/hellostr"
            android:textColor="@color/linear_text_primary"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:text="Welcome to the Salavat audio guide"
            android:textColor="@color/linear_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="Салауат аудиогидына рәхим итегеҙ"
            android:textColor="@color/linear_text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRu"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/linear_accent"
        android:fontFamily="sans-serif-medium"
        android:text="Продолжить на Русском"
        android:textAllCaps="false"
        android:textColor="@color/linear_text_primary"
        android:textSize="15sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnEn"
        app:strokeColor="@color/linear_border_subtle"
        app:strokeWidth="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/linear_surface_low"
        android:fontFamily="sans-serif-medium"
        android:text="Continue in English"
        android:textAllCaps="false"
        android:textColor="@color/linear_text_primary"
        android:textSize="15sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBash"
        app:strokeColor="@color/linear_border_subtle"
        app:strokeWidth="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBash"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/linear_surface_low"
        android:fontFamily="sans-serif-medium"
        android:text="Дауамы Башҡортса"
        android:textAllCaps="false"
        android:textColor="@color/linear_text_primary"
        android:textSize="15sp"
        app:cornerRadius="8dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/linear_border_subtle"
        app:strokeWidth="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>